{
  "name": "mathsemble",
  "private": true,
  "version": "0.2.4",
  "description": "Obsidian desktop mathematics handouts and student/teacher PDF exports",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm run build && npm test && npm run verify",
    "prepublish-check": "npm run check && node scripts/prepublish.mjs"
  },
  "devDependencies": {
    "@mathjax/mathjax-tex-font": "4.1.3",
    "mathjax": "4.1.3"
  }
}
